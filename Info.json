{
  "name": "Advanced Playlist",
  "identifier": "io.iina.playlist-pro",
  "version": "1.0.0",
  "ghVersion": 1,
  "author": {
    "name": "somename",
    "email": "muuberullez@gmail.com"
  },
  "description": "A full-featured music playlist: artist / album / title, search, sorting, drag-to-reorder, save/load playlists, YouTube Music search, a detachable resizable window, and configurable playback hotkeys.",
  "entry": "main.js",
  "preferencesPage": "ui/preferences.html",
  "sidebarTab": {
    "name": "Advanced Playlist"
  },
  "permissions": [
    "file-system",
    "show-osd"
  ],
  "preferenceDefaults": {
    "winW": 620,
    "winH": 520,
    "hideMain": false,
    "hk_prev": "z",
    "hk_play": "x",
    "hk_pause": "c",
    "hk_stop": "v",
    "hk_next": "b",
    "hk_seekBack": "",
    "hk_seekFwd": "",
    "ytdlpPath": "",
    "autoSave": false,
    "restoreLastPlaylist": true,
    "lastPlaylistName": "",
    "showOnStart": "sidebar",
    "pausePlaylistOnOpen": true,
    "pauseHoldSeconds": 1,
    "ytmSortByPlays": false
  }
}
